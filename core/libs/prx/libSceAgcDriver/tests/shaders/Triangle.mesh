#version 460
#extension GL_EXT_mesh_shader : require
layout(local_size_x = 1) in;
layout(triangles, max_vertices = 3, max_primitives = 1) out;
layout(set = 2, binding = 66) uniform texture2D heapImages[4096];
layout(set = 2, binding = 122) uniform sampler heapSamplers[256];
layout(std430, set = 3, binding = 0) readonly buffer Buckets { uint words[]; } buckets;
layout(location = 0) out vec3 color[];
void main() {
    SetMeshOutputsEXT(3, 1);
    vec2 positions[3] = vec2[](vec2(-0.8, -0.7), vec2(0.8, -0.7), vec2(0.0, 0.8));
    vec3 tint = textureLod(sampler2D(heapImages[0], heapSamplers[0]), vec2(0.5), 0.0).rgb + vec3(float(buckets.words[0]));
    for (uint vertex = 0u; vertex < 3u; ++vertex) {
        gl_MeshVerticesEXT[vertex].gl_Position = vec4(positions[vertex], 0.5, 1.0);
        color[vertex] = tint;
    }
    gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0u, 1u, 2u);
}
